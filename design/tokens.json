    {"foreground": "syntax.string", "backgrounds": ["surface.content"], "min": 4.5},
    {"foreground": "syntax.function", "backgrounds": ["surface.content"], "min": 4.5},
    {"foreground": "syntax.number", "backgrounds": ["surface.content"], "min": 3.0},
    {"foreground": "syntax.comment", "backgrounds": ["surface.content"], "min": 3.0}
