{
  "comment": "Fonte ÚNICA dos tokens de cor do RSKeeper (W0-T25; docs/native/07 §2, §12). Identidade própria: acento teal (matiz 195). Nenhuma cor do Beekeeper. Valores: '#RRGGBB' ou '#RRGGBB@alpha'. Variantes: dark, light, darkHC, lightHC (alto contraste; ausente = mesma da normal). Gerar com: swift scripts/dev/generate-tokens.swift",
  "primitives": {
    "neutral": {"0": "#FFFFFF", "25": "#FAFBFC", "50": "#F4F6F8", "100": "#E9ECF0", "150": "#DDE1E6", "200": "#CDD3DA", "300": "#B4BCC6", "400": "#9AA3AE", "500": "#7C8592", "600": "#5E6773", "700": "#474E58", "800": "#2F343B", "850": "#24282E", "900": "#1C1F24", "925": "#17191D", "950": "#121417", "975": "#0D0E10"},
