    "green": {"400": "#4CC27E", "600": "#25854F"},
    "amber": {"400": "#E3A93A", "600": "#A86F0A"},
    "red": {"400": "#F0695F", "600": "#C23A32"},
    "blue": {"400": "#5C9BEB", "600": "#2F68BF"},
