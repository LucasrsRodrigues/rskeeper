// Ambiente de testes (W0-T10). RSK_TEST_BUILD existe SÓ aqui (aceite 3).
#include "Base.xcconfig"

RSK_ENVIRONMENT = test
RSK_BUNDLE_ID_SUFFIX = $(RSK_BUNDLE_ID_SUFFIX_TEST)
RSK_APP_PRODUCT_NAME = RSKeeper Test
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG RSK_TEST_BUILD

SWIFT_OPTIMIZATION_LEVEL = -Onone
GCC_OPTIMIZATION_LEVEL = 0
ONLY_ACTIVE_ARCH = YES
ENABLE_TESTABILITY = YES
DEBUG_INFORMATION_FORMAT = dwarf
