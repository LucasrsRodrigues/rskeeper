// Ambiente de desenvolvimento (W0-T10).
#include "Base.xcconfig"

RSK_ENVIRONMENT = dev
RSK_BUNDLE_ID_SUFFIX = $(RSK_BUNDLE_ID_SUFFIX_DEV)
RSK_APP_PRODUCT_NAME = RSKeeper Dev
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG RSK_DEV_BUILD

SWIFT_OPTIMIZATION_LEVEL = -Onone
GCC_OPTIMIZATION_LEVEL = 0
ONLY_ACTIVE_ARCH = YES
ENABLE_TESTABILITY = YES
DEBUG_INFORMATION_FORMAT = dwarf
